{
    "configurations": [
        {
            "browse": {
                "databaseFilename": "${default}",
                "limitSymbolsToIncludedHeaders": false
            },
            "includePath": [
                "/opt/ros/humble/include/**",
                "/usr/include/**",
                "${workspaceFolder}/src/sensors/inc",
                "${workspaceFolder}/src/utility/inc",
                "${workspaceFolder}/src/sensors/src",
                "${workspaceFolder}/src/threads/inc",
                "${workspaceFolder}/src/mouse/inc"
            ],
            "name": "ROS",
            "intelliSenseMode": "gcc-x64",
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "gnu11",
            "cppStandard": "c++14"
        }
    ],
    "version": 4
}