{
    "configurations": [
        {
            "browse": {
                "databaseFilename": "${default}",
                "limitSymbolsToIncludedHeaders": false
            },
            "includePath": [
                "${workspaceFolder}/src/capture/inc",
                "${workspaceFolder}/src/detect/inc",
                "${workspaceFolder}/src/sensors/inc",
                "${workspaceFolder}/src/utility/inc",
                "${workspaceFolder}/src/threads/inc",
                "${workspaceFolder}/src/track/inc",
                "${workspaceFolder}/src/mouse/inc",
                "/usr/include/opencv4",
                "${workspaceFolder}/.deps/flatbuffers-25.2.10/include",
                "/opt/intel/openvino_2025/runtime/include",
                "${workspaceFolder}/config/autogenerated_flatbuffers"
            ],
            "name": "Dart Ubuntu 22.04",
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cStandard": "gnu11",
            "cppStandard": "c++20"
        }
    ],
    "version": 4
}
